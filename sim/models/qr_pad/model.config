<?xml version="1.0"?>
<model>
  <name>qr_pad</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>g0rk</name>
  </author>
  <description>
    2m x 2m QR kodlu zemin ve 45 derece acili, 3 m yuksekliginde yan plakalar.
    TEKNOFEST Savasan IHA sartnamesi s.17'ye gore.

    NOT: model.config eskiden "2.5m x 2.5m" diyordu; model.sdf ise dogru
    olarak 2x2 uretiyor. Sartname 2m x 2m sart kosuyor, aciklama duzeltildi.
    Olcu icin model.sdf esastir.
  </description>
</model>