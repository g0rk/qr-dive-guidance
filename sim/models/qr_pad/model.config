<?xml version="1.0"?>
<model>
  <name>qr_pad</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>g0rk</name>
  </author>
  <description>
    A 2 m x 2 m QR-coded ground panel with side plates 3 m tall, angled at
    45 degrees. Per the TEKNOFEST rulebook, p.17.

    NOTE: this model.config used to say "2.5m x 2.5m" while model.sdf built
    the correct 2x2. The rulebook requires 2 m x 2 m, so the description was
    the thing that was wrong. For dimensions, model.sdf is authoritative.
  </description>
</model>