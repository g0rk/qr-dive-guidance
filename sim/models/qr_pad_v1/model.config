<?xml version="1.0"?>
<model>
  <name>qr_pad_v1</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>g0rk</name>
  </author>
  <description>
    2m x 2m QR kodlu zemin ve 45 derece acili, 3 m yuksekliginde yan plakalar.
    TEKNOFEST Savasan IHA sartnamesi s.17'ye gore.

    qr_pad'den FARKI - dokusu duzeltildi:
      QR Versiyon 1 (21x21 modul).  Haberlesme Dokumani 9:
        "Yarismada kullanilacak QR kodu Versiyon 1 olacaktir."
      Sessiz bolge 2 modul (80 px / 840 px).  Taban modelde 0.2 modul
      (8 px / 984 px) idi; standart 4 modul ister ve dusuk sessiz bolge
      decode menzilini kisaltiyordu.
    Geometri qr_pad ile AYNI, yalnizca materials/textures/qr_code.png farkli.
    Dunya bu modeli kullanir (sim/worlds/qr_target.sdf).
  </description>
</model>