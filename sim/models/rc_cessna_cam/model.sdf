<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='rc_cessna_cam'>
    <!-- Kalip PX4'un x500_mono_cam modelinden alindi. -->
    <include merge='true'>
      <uri>rc_cessna</uri>
    </include>

    <include merge='true'>
      <uri>model://nose_cam</uri>
      <pose>0.45 0 0.05 0 0 0</pose>
    </include>

    <!--
      Kamera burunda ve GOVDE EKSENIYLE PARALEL (sartname s.10).
      x=0.45 govdenin onu; z=0.05 hafif yukarida.
      ⚠️ Bu poz gozle dogrulanmali - mesh 0.1 olcekli, burnun tam yeri
         olculmedi. Kameranin YONELIMI (0 0 0) kritik olan; konum birkac
         santim kaysa sonuc degismez.
    -->
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>nose_cam/base_link</child>
      <pose relative_to="base_link">0.45 0 0.05 0 0 0</pose>
    </joint>
  </model>
</sdf>
