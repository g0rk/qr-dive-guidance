<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='rc_cessna_cam'>
    <!-- Patterned on PX4's own x500_mono_cam model. -->
    <include merge='true'>
      <uri>rc_cessna</uri>
    </include>

    <include merge='true'>
      <uri>model://nose_cam</uri>
      <pose>0.45 0 0.05 0 0 0</pose>
    </include>

    <!--
      The camera sits in the nose, PARALLEL TO THE BODY AXIS (rulebook p.10).
      x=0.45 is the front of the fuselage; z=0.05 lifts it slightly.
      ⚠️ This pose should be checked by eye - the mesh is at 0.1 scale and
         the exact position of the nose was never measured. What matters is
         the camera's ORIENTATION (0 0 0); a few centimetres of offset in
         position changes nothing.
    -->
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>nose_cam/base_link</child>
      <pose relative_to="base_link">0.45 0 0.05 0 0 0</pose>
    </joint>
  </model>
</sdf>
