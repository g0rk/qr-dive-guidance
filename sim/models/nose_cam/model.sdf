<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='nose_cam'>
    <!--
      PX4'un mono_cam'inden turetildi. PARAMETRELER DEGISTIRILDI cunku
      mono_cam bizim donanimi temsil etmiyordu:

                     mono_cam        nose_cam (gercek donanim)
        HFOV         1.74 rad =99.7  0.8950 rad = 51.28 derece
        cozunurluk   640x480         1920x1080

      ==========================================================
      GERCEK KAMERA — ARTIK VARSAYIM DEGIL (dogrulandi 2026-08-05)
      ==========================================================
        Model      : DFM 37UR0234-ML (The Imaging Source)
        Sensor     : onsemi AR0234CS CMOS
        Format     : 1/2.6"
        Cozunurluk : 1920 x 1200
        Piksel     : 3.0 um
        Efektif alan (ureticiden) : 5.62 mm x 3.20 mm
        Lens       : 6 mm

      Onceki oturum "6mm + 2MP -> 1/2.6 inc (AR0234)" diye VARSAYMISTI.
      VARSAYIM DOGRU CIKTI. Onceki tum menzil/geometri olcumleri gecerli.

      === HFOV neden 0.8950 rad? ===
      HFOV = 2 * atan(sensor_genisligi / (2 * odak_uzakligi))
           = 2 * atan(5.76 / (2 * 6)) = 51.28 derece = 0.8950 rad

      ⚠️ NEDEN 5.76 ve ureticinin dedigi 5.62 DEGIL:
      Ureticinin sayfasi KENDI ICINDE CELISKILI —
          1920 px x 3.0 um = 5.76 mm  (ureticinin dedigi: 5.62)
          1200 px x 3.0 um = 3.60 mm  (ureticinin dedigi: 3.20)
          1080 px x 3.0 um = 3.24 mm  <- "3.20" buna cok daha yakin
      Yani "efektif alan" muhtemelen tam 1920x1200 dizisi degil.
      Renderer ignesi (pinhole) piksel geometrisiyle tutarli olmali:
      gz 1920 sutun ornekliyor, her sutun 3.0 um -> 5.76 mm.

      Belirsizligin BUYUKLUGU ve YONU (onemli olan bu):
          5.76 mm -> 51.28 derece
          5.62 mm -> 50.19 derece     fark yalnizca 1.09 derece (%2.1)
      Genis HFOV = ayni 1920 piksele daha cok dunya sigar = hedef daha
      KUCUK gorunur. Yani 51.28 kullanmak, gercek 50.19 ise, QR'i
      %2.1 KUCUK gosterir -> decode menzilini OLDUGUNDAN KOTU tahmin
      ederiz. Hata GUVENLI yonde. Olculen 40 m decode esigi bundan
      etkilenmez (esik 10 m'lik basamaklarla olculdu).
      KESIN CEVAP: kamera elde olunca satranc tahtasi + OpenCV
      calibrateCamera ile OLCULMELI. Datasheet tartismasi degil, olcum.

      === Neden 1200 degil 1080 satir? ===
      Sensor 1920x1200 = 16:10. Sartname s.12 yalnizca 4:3, 5:4 ve 16:9
      en-boy oranlarina izin veriyor. 16:10 LISTEDE YOK -> hakem videosu
      16:9 olmak ZORUNDA. Bu yuzden 1080 satira kirpiliyor (ustten ve
      alttan 60'sar satir atilir).
      Sonuc: dikey gorus alani VFOV = 2*atan(tan(HFOV/2)*1080/1920)
                                    = 30.22 derece
             (tam sensor kullanilsaydi 33.40 derece olurdu — kullanamayiz)

      Sartname s.10: "kamera, hava aracinin burnunda, hava aracinin yatay
      eksenine paralel ve sabit olacak sekilde konumlandirilmalidir."
      -> poz 0 0 0 0 0 0 (govde ekseniyle ayni), burna monte edilir.
    -->
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="nose_cam/base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.050</mass>
        <inertia>
          <ixx>0.00004</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00004</iyy><iyz>0</iyz><izz>0.00004</izz>
        </inertia>
      </inertial>
      <sensor name="imager" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <!-- 2*atan(5.76/12) = 0.895045 rad = 51.28 derece. Onceki deger
               0.8954'tu (0.023 derece fark, 70 px'lik QR'da 0.03 px —
               olculebilir bir etkisi yok, yalnizca yukaridaki turetmeyle
               birebir tutsun diye duzeltildi). -->
          <horizontal_fov>0.8950</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>camera</topic>
      </sensor>
      <gravity>true</gravity>
      <velocity_decay/>
    </link>
  </model>
</sdf>
