<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="grass_field">
    <static>true</static>
    <link name="field">
      <!-- Zemin duzleminin 1 cm ustunde; z-fighting olmasin -->
      <pose>0 0 0.005 0 0 0</pose>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <box><size>160 160 0.01</size></box>
        </geometry>
        <material>
          <ambient>0.5 0.55 0.4 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/grass.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
