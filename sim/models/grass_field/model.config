<?xml version="1.0"?>
<model>
  <name>grass_field</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    A textured grass patch, placed around the QR pad.
    IT IS NOT ONLY COSMETIC: with the QR sitting on flat, single-coloured
    ground, detection is EASIER than it would be in reality. A textured
    background tests the perception chain against something realistic.
  </description>
</model>
